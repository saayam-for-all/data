DATABASE_URL=postgresql://user:password@localhost:5432/saayam
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# src/main.py (FastAPI analytics API) local DB connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saayam
DB_USER=postgres
DB_PASSWORD=password
SECRET_KEY=dev-only-secret-change-me

# Schema qualifying the organizations table for the Organization Analytics API (issue #228)
ORG_ANALYTICS_SCHEMA=virginia_dev_saayam_rdbms

# src/steward-volunteer-review (Steward Dashboard Review Volunteers API, issue #273)
# DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD above are reused for local testing.
# In a deployed environment, set DB_CREDENTIALS_PARAM to the AWS Parameter Store
# path holding DB creds instead - leave it unset locally (no path is hardcoded in code).
DB_CREDENTIALS_PARAM=
# application_status value(s) (comma-separated) that require steward review -
# confirm with `SELECT DISTINCT application_status FROM volunteer_applications;`
STEWARD_REVIEW_STATUSES=UNDER_REVIEW
# Optional schema qualifying the users / volunteer_applications tables
STEWARD_REVIEW_DB_SCHEMA=
