# The CLI reads the process environment, not this file automatically.
PROFANITY_API_URL=https://your-api-host.example/check-profanity
PROFANITY_API_KEY=
PROFANITY_API_TIMEOUT=10
# HTTP is allowed only on loopback, and only with this explicit opt-in.
PROFANITY_ALLOW_LOCAL_HTTP=false
# Local SQLite is the default. No tables are created during module import.
TASK422_DATABASE_URL=sqlite:///task422.sqlite3
# For PostgreSQL, set an existing approved schema and active request status ID.
TASK422_DB_SCHEMA=
TASK422_ACTIVE_STATUS_ID=
