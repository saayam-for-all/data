# organization_analytics.py - local configuration.
# Copy to `.env` (or export these in your shell) for LOCAL runs.
#
# There is NO AWS Parameter Store / SSM fallback in this Lambda. If DB_HOST is
# unset, get_db_connection() raises instead of reaching for shared credentials,
# so there is no code path from here to the production database.
#
# Development and testing run against the mock fixtures committed in
# data-analytics/sql (organizations.csv, state.csv). The test suite in
# data-analytics/tests loads them itself and needs none of these variables:
#
#     python data-analytics/tests/test_organization_analytics.py

# --- Local Postgres connection (required for a live run) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saayam_local
DB_USER=postgres
DB_PASSWORD=postgres

# --- Guarded contributor support ---
# The mock fixtures define is_contributor, so contributor metrics are ON by
# default. Set this to false against a database where the column does not
# exist yet; every contributor metric then returns 0 / [] without referencing
# the column, and the JSON response keys stay unchanged.
ORG_IS_CONTRIBUTOR=true

# --- Test backend (optional) ---
# Unset/sqlite: run the suite on an in-memory SQLite shim, no server needed.
# postgres:     run the identical suite against the local DB_* database above.
MOCK_DB_BACKEND=sqlite
