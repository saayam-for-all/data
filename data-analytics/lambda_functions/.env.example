# organization_analytics.py — local / env-aware configuration.
# Copy to `.env` (or export these in your shell) for LOCAL runs.
# When DB_HOST is unset, the Lambda falls back to the unchanged SSM
# credential lookup used by kpi_api_analytics.py (no values needed here).

# --- Local Postgres connection (used only when DB_HOST is set) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saayam_local
DB_USER=postgres
DB_PASSWORD=postgres

# --- Guarded contributor support ---
# The production DB has NO is_contributor column yet. Leave this false (or
# unset) until the migration lands; contributor metrics then return 0 / [].
# Set to true ONLY where the is_contributor column actually exists.
ORG_IS_CONTRIBUTOR=false
