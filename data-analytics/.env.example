# Local Postgres connection settings for the Organization Analytics API (issue #228).
#
# IMPORTANT: Per issue #228, this project must NOT read DB credentials from
# AWS Parameter Store / SSM. Connection info comes from plain environment
# variables only -- copy this file to `.env` and adjust values as needed.

PGHOST=localhost
PGPORT=5432
PGDATABASE=saayam_dev
PGUSER=postgres
PGPASSWORD=postgres

# Schema used by organizations_schema.sql, load_local_data.py, and
# organization_analytics.py.
SAAYAM_SCHEMA=virginia_dev_saayam_rdbms
